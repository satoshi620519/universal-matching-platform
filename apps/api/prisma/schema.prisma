generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String                   @id @default(uuid()) @db.Uuid
  status                   String
  createdAt                DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(6)
  authenticationIdentities AuthenticationIdentity[]
  verificationRequests      VerificationRequest[]
  safetyEnforcements        SafetyEnforcement[]

  @@map("accounts")
}

model AuthenticationIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  providerType    String   @map("provider_type")
  providerSubject String   @map("provider_subject")
  status          String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  account         Account  @relation(fields: [accountId], references: [id])

  @@unique([providerType, providerSubject])
  @@index([accountId])
  @@map("authentication_identities")
}

model VerificationRequest {
  id                String                @id @default(uuid()) @db.Uuid
  accountId         String                @map("account_id") @db.Uuid
  requestedLevel    Int                   @map("requested_level")
  workflowReference String                @map("workflow_reference")
  status            String
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(6)
  expiresAt         DateTime?             @map("expires_at") @db.Timestamptz(6)
  account           Account               @relation(fields: [accountId], references: [id])
  outcomes          VerificationOutcome[]

  @@index([accountId, status])
  @@map("verification_requests")
}

model VerificationOutcome {
  id                    String              @id @default(uuid()) @db.Uuid
  verificationRequestId String              @map("verification_request_id") @db.Uuid
  level                 Int
  status                String
  decidedAt             DateTime?           @map("decided_at") @db.Timestamptz(6)
  reasonCategory        String?             @map("reason_category")
  expiresAt             DateTime?           @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id])

  @@index([verificationRequestId])
  @@map("verification_outcomes")
}


model SafetyEnforcement {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  restriction    String
  reasonCategory String   @map("reason_category")
  status         String
  effectiveAt    DateTime @map("effective_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  account        Account  @relation(fields: [accountId], references: [id])

  @@index([accountId, status, effectiveAt])
  @@map("safety_enforcements")
}
