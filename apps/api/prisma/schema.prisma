generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String                   @id @default(uuid()) @db.Uuid
  status                   String
  createdAt                DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(6)
  authenticationIdentities AuthenticationIdentity[]
  verificationRequests      VerificationRequest[]
  safetyEnforcements        SafetyEnforcement[]
  authenticationSessions    AuthenticationSession[]
  emailVerificationTokens   EmailVerificationToken[]
  emailOutboxMessages       EmailOutboxMessage[]
  roleAssignments           RoleAssignment[]
  assignedRoleAssignments   RoleAssignment[] @relation("RoleAssignmentAssigner")

  @@map("accounts")
}

model AuthenticationIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  providerType    String   @map("provider_type")
  providerSubject String   @map("provider_subject")
  status          String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  account         Account  @relation(fields: [accountId], references: [id])
  passwordCredential PasswordCredential?

  @@unique([providerType, providerSubject])
  @@index([accountId])
  @@map("authentication_identities")
}

model VerificationRequest {
  id                String                @id @default(uuid()) @db.Uuid
  accountId         String                @map("account_id") @db.Uuid
  requestedLevel    Int                   @map("requested_level")
  workflowReference String                @map("workflow_reference")
  status            String
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(6)
  expiresAt         DateTime?             @map("expires_at") @db.Timestamptz(6)
  account           Account               @relation(fields: [accountId], references: [id])
  outcomes          VerificationOutcome[]

  @@index([accountId, status])
  @@map("verification_requests")
}

model VerificationOutcome {
  id                    String              @id @default(uuid()) @db.Uuid
  verificationRequestId String              @map("verification_request_id") @db.Uuid
  level                 Int
  status                String
  decidedAt             DateTime?           @map("decided_at") @db.Timestamptz(6)
  reasonCategory        String?             @map("reason_category")
  expiresAt             DateTime?           @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id])

  @@index([verificationRequestId])
  @@map("verification_outcomes")
}


model SafetyEnforcement {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  restriction    String
  reasonCategory String   @map("reason_category")
  status         String
  effectiveAt    DateTime @map("effective_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  account        Account  @relation(fields: [accountId], references: [id])

  @@index([accountId, status, effectiveAt])
  @@map("safety_enforcements")
}


model PasswordCredential {
  authenticationIdentityId String   @id @map("authentication_identity_id") @db.Uuid
  passwordHash             String   @map("password_hash")
  status                   String
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  authenticationIdentity   AuthenticationIdentity @relation(fields: [authenticationIdentityId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model AuthenticationSession {
  id                   String   @id @default(uuid()) @db.Uuid
  accountId            String   @map("account_id") @db.Uuid
  authenticationMethod String   @map("authentication_method")
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  credentialHash       String    @unique @map("credential_hash")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@index([expiresAt])
  @@map("authentication_sessions")
}


model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("email_verification_tokens")
}


model EmailOutboxMessage {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  emailAddress String    @map("email_address")
  kind         String
  status       String
  attempts     Int       @default(0)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz(6)
  failedAt     DateTime? @map("failed_at") @db.Timestamptz(6)
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, failedAt])
  @@index([accountId, createdAt])
  @@map("email_outbox_messages")
}


model Role {
  id          String           @id @default(uuid()) @map("role_id") @db.Uuid
  key         String           @unique @map("role_key")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  assignments RoleAssignment[]

  @@map("roles")
}

model RoleAssignment {
  id                  String   @id @default(uuid()) @map("role_assignment_id") @db.Uuid
  accountId           String   @map("account_id") @db.Uuid
  roleId              String   @map("role_id") @db.Uuid
  effectiveAt         DateTime @map("effective_at") @db.Timestamptz(6)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  assignedByAccountId String?  @map("assigned_by_account_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account             Account  @relation(fields: [accountId], references: [id])
  role                Role     @relation(fields: [roleId], references: [id])
  assignedBy          Account? @relation("RoleAssignmentAssigner", fields: [assignedByAccountId], references: [id])

  @@index([accountId, effectiveAt])
  @@index([roleId, effectiveAt])
  @@map("role_assignments")
}
