{
  "name": "@universal/database",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-migrations.mjs && node ./scripts/flatten-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify:migrations-build": "pnpm run build && node ./scripts/verify-migrations-build.mjs",
    "migrate": "pnpm run build && node ./scripts/migrate-postgres.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "files": [
    "dist/**",
    "migrations/**"
  ],
  "dependencies": {
    "pg": "^8.13.1"
  }
}
